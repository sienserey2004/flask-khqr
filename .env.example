# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=1

# Bakong / KHQR token
#  - "rbk_..." token from KHQR.dev  -> only amount is needed, merchant info comes from your store
#  - NBC developer token            -> fill in the merchant fields below
BAKONG_TOKEN=your_bakong_token_here

# Verify SSL certificate when calling the Bakong API (false = skip, like requests verify=False)
BAKONG_SSL_VERIFY=false

# Merchant info (required when using an NBC developer token)
BAKONG_ACCOUNT_ID=your_name@bank
MERCHANT_NAME=My Store
MERCHANT_CITY=Phnom Penh
MERCHANT_PHONE=012345678
STORE_LABEL=MyShop
TERMINAL_LABEL=WEB-01
CURRENCY=USD
